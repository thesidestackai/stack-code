#!/usr/bin/env bash
# claw-sidestack-local — opt-in wrapper that routes `claw` through the
# SideStackAI local broker by sourcing `examples/sidestack-local.env`.
#
# LAW 1: this wrapper MUST NOT execute `claw` if the final effective
# `OPENAI_BASE_URL` points at the raw Ollama port (`:11434`) or otherwise
# fails the broker allowlist below. The check runs *after* sourcing the
# profile, so the profile's value is what is validated.
#
# Liveness of the broker is NOT checked here — use `claw doctor` or a
# separate runtime check for that.
#
# CANONICAL ENTRYPOINT: this wrapper executes the canonical SideStackAI claw
# at $HOME/.local/bin/claw (override with CLAW_CANONICAL_PATH). It never
# resolves `claw` from PATH, so it can never silently fall through to a stale
# ~/.cargo/bin/claw or a Cargo target artifact. Freshness and topology are
# delegated to scripts/claw-canonical-status, which is offline and read-only.
#
# Exit codes:
#   2  broker profile env file missing
#   3  LAW 1 refusal (evaluated before any canonical/freshness check)
#   4  canonical claw missing
#   5  canonical claw has invalid topology (symlink / not a regular executable)
#   6  canonical claw is stale relative to the locally known origin/main
#   7  the canonical status check itself could not run
#
# Residual race
# -------------
# The status helper runs in a separate process, so its topology check and this
# wrapper's `exec` cannot be one atomic operation. The topology is therefore
# revalidated here immediately before `exec`, which is the last practical
# moment shell affords. POSIX shell cannot exec with O_NOFOLLOW/openat2
# semantics portably across Linux, macOS, and WSL, so a SAME-USER process
# racing between that final check and the `exec` remains possible. The window
# is narrowed, not eliminated.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
ENV_FILE="${REPO_ROOT}/examples/sidestack-local.env"

if [[ ! -f "${ENV_FILE}" ]]; then
  printf 'claw-sidestack-local: env file not found: %s\n' "${ENV_FILE}" >&2
  printf '  expected the SideStackAI broker profile at examples/sidestack-local.env\n' >&2
  exit 2
fi

# shellcheck source=/dev/null
source "${ENV_FILE}"

EFFECTIVE_BASE_URL="${OPENAI_BASE_URL:-}"

if [[ -z "${EFFECTIVE_BASE_URL}" ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL is empty after sourcing %s\n' "${ENV_FILE}" >&2
  exit 3
fi

if [[ "${EFFECTIVE_BASE_URL}" == *11434* ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL must not point at :11434 (raw Ollama).\n' >&2
  printf '  offending value: %s\n' "${EFFECTIVE_BASE_URL}" >&2
  printf '  expected the SideStackAI broker on :11435.\n' >&2
  exit 3
fi

BROKER_ALLOWLIST_REGEX='^http://(127\.0\.0\.1|localhost):11435(/.*)?$'
if [[ ! "${EFFECTIVE_BASE_URL}" =~ ${BROKER_ALLOWLIST_REGEX} ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL is not an allowed SideStackAI broker URL.\n' >&2
  printf '  offending value: %s\n' "${EFFECTIVE_BASE_URL}" >&2
  printf '  allowlist regex: %s\n' "${BROKER_ALLOWLIST_REGEX}" >&2
  exit 3
fi

{
  printf 'claw-sidestack-local: active profile\n'
  printf '  OPENAI_BASE_URL=%s\n' "${OPENAI_BASE_URL}"
  printf '  RUSTY_CLAUDE_LLM_CALLER=%s\n' "${RUSTY_CLAUDE_LLM_CALLER:-}"
  printf '  RUSTY_CLAUDE_TASK_TYPE=%s\n' "${RUSTY_CLAUDE_TASK_TYPE:-}"
  alias_names="$(compgen -e | grep -E '^RUSTY_CLAUDE_MODEL_ALIAS__' | sort | tr '\n' ' ' || true)"
  if [[ -n "${alias_names}" ]]; then
    printf '  model alias env names: %s\n' "${alias_names% }"
  else
    printf '  model alias env names: (none)\n'
  fi
} >&2

# --- canonical entrypoint ---------------------------------------------------
#
# LAW 1 has already been evaluated above; nothing below it may relax that.
# From here the only question is whether the canonical executable is the one
# we are allowed to run.

if [[ -z "${CLAW_CANONICAL_PATH:-}" && -z "${HOME:-}" ]]; then
  printf 'claw-sidestack-local: HOME is unset and CLAW_CANONICAL_PATH was not provided.\n' >&2
  exit 7
fi
CANONICAL_CLAW="${CLAW_CANONICAL_PATH:-${HOME}/.local/bin/claw}"
if [[ "${CANONICAL_CLAW}" != /* ]]; then
  printf 'claw-sidestack-local: canonical claw path must be absolute: %s\n' "${CANONICAL_CLAW}" >&2
  exit 7
fi
printf '  canonical claw: %s\n' "${CANONICAL_CLAW}" >&2

CANONICAL_STATUS="${SCRIPT_DIR}/claw-canonical-status"
if [[ ! -x "${CANONICAL_STATUS}" ]]; then
  printf 'claw-sidestack-local: canonical status helper missing or not executable: %s\n' "${CANONICAL_STATUS}" >&2
  exit 7
fi

set +e
status_report="$("${CANONICAL_STATUS}" 2>&1)"
status_rc=$?
set -e

print_status_report() {
  if [[ -n "${status_report}" ]]; then
    while IFS= read -r status_line; do
      printf '  %s\n' "${status_line}" >&2
    done <<<"${status_report}"
  fi
}

case "${status_rc}" in
  0)
    ;;
  10)
    print_status_report
    if [[ "${CLAW_SIDESTACK_ALLOW_STALE:-0}" == "1" ]]; then
      printf 'claw-sidestack-local: WARNING — canonical claw is STALE and CLAW_SIDESTACK_ALLOW_STALE=1 was set.\n' >&2
      printf '  running a build that does not match the locally known origin/main, at your explicit request.\n' >&2
    else
      printf 'claw-sidestack-local: refusing to run a STALE canonical claw.\n' >&2
      printf '  refresh it with: %s/claw-canonical-refresh\n' "${SCRIPT_DIR}" >&2
      printf '  (or set CLAW_SIDESTACK_ALLOW_STALE=1 to override deliberately)\n' >&2
      exit 6
    fi
    ;;
  11)
    print_status_report
    printf 'claw-sidestack-local: canonical claw is missing: %s\n' "${CANONICAL_CLAW}" >&2
    printf '  install it with: %s/claw-canonical-refresh\n' "${SCRIPT_DIR}" >&2
    printf '  this wrapper does NOT fall back to PATH or to ~/.cargo/bin/claw.\n' >&2
    exit 4
    ;;
  12)
    print_status_report
    printf 'claw-sidestack-local: canonical claw has an invalid topology: %s\n' "${CANONICAL_CLAW}" >&2
    printf '  canonical claw must be a regular executable file, never a symlink to a Cargo target.\n' >&2
    exit 5
    ;;
  13)
    print_status_report
    printf 'claw-sidestack-local: WARNING — freshness could not be determined (no locally known origin/main).\n' >&2
    # shellcheck disable=SC2016  # backticks in the user-facing message are literal
    printf '  running the canonical executable anyway; run `git fetch origin main` to restore the check.\n' >&2
    ;;
  *)
    print_status_report
    printf 'claw-sidestack-local: canonical status check failed (exit %s).\n' "${status_rc}" >&2
    exit 7
    ;;
esac

# --- final topology revalidation, immediately before exec -------------------
#
# Nothing may run between this block and `exec`. See the Residual race note in
# the header: this narrows the same-user window, it does not close it.
if [[ -L "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is a symlink: %s\n' "${CANONICAL_CLAW}" >&2
  printf '  canonical claw must be a regular executable file, never a symlink to a Cargo target.\n' >&2
  exit 5
fi
if [[ ! -e "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is missing: %s\n' "${CANONICAL_CLAW}" >&2
  printf '  this wrapper does NOT fall back to PATH or to ~/.cargo/bin/claw.\n' >&2
  exit 4
fi
if [[ ! -f "${CANONICAL_CLAW}" || ! -x "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is not a regular executable file: %s\n' "${CANONICAL_CLAW}" >&2
  exit 5
fi

exec "${CANONICAL_CLAW}" "$@"
