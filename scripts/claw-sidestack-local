#!/usr/bin/env bash
# claw-sidestack-local — opt-in wrapper that routes `claw` through the
# SideStackAI local broker by sourcing `examples/sidestack-local.env`.
#
# LAW 1: this wrapper MUST NOT execute `claw` if the final effective
# `OPENAI_BASE_URL` points at the raw Ollama port (`:11434`) or otherwise
# fails the broker allowlist below. The check runs *after* sourcing the
# profile, so the profile's value is what is validated.
#
# Liveness of the broker is NOT checked here — use `claw doctor` or a
# separate runtime check for that.
#
# CANONICAL ENTRYPOINT: this wrapper executes the canonical SideStackAI claw
# at $HOME/.local/bin/claw (override with CLAW_CANONICAL_PATH). It never
# resolves `claw` from PATH, so it can never silently fall through to a stale
# ~/.cargo/bin/claw or a Cargo target artifact. Freshness and topology are
# delegated to scripts/claw-canonical-status, which is offline and read-only.
#
# Exit codes:
#   2  broker profile env file missing
#   3  LAW 1 refusal (evaluated before any canonical/freshness check)
#   4  canonical claw missing
#   5  canonical claw has invalid topology (symlink / not a regular executable)
#   6  canonical claw is stale relative to the locally known origin/main
#   7  the canonical status check itself could not run
#   8  broker readiness refused the session (`ready=false`)
#   9  broker readiness could not be established (endpoint unreachable, timed
#      out, non-2xx, malformed, or the requested upstream model is unknown),
#      OR the invocation can reach a provider but its exact upstream model is
#      not determinable here at all (`task run`, `plan run --wrapper <other>`),
#      OR the resolved `curl` does not report a version that enforces the
#      response-size bound (see the curl capability floor below), in which
#      case no request is made
#
# Residual race
# -------------
# The status helper runs in a separate process, so its topology check and this
# wrapper's `exec` cannot be one atomic operation. The topology is therefore
# revalidated here immediately before `exec`, which is the last practical
# moment shell affords. POSIX shell cannot exec with O_NOFOLLOW/openat2
# semantics portably across Linux, macOS, and WSL, so a SAME-USER process
# racing between that final check and the `exec` remains possible. The window
# is narrowed, not eliminated.
#
# The same is true of the N6 broker readiness gate added below. It is a
# CLIENT-side refusal, not an atomic broker admission reservation: a
# time-of-check/time-of-use interval remains between the readiness GET and the
# first inference POST that the canonical claw issues. The broker's 300-second
# Hyperliquid quiet window makes that residual race acceptable under the
# current operating contract, but it is a real window, not a proof. Raw POSTs
# made directly to the broker bypass this wrapper and therefore this gate
# entirely.
#
# Trusted local dependencies
# --------------------------
# This wrapper treats the resolved local `curl` program — and the same-user
# filesystem and environment that contain it — as TRUSTED for the duration of
# one invocation. That trust is an assumption, not something the wrapper
# verifies, and it bounds every claim made below.
#
# Within that assumption the wrapper does defend against: accidental PATH
# re-resolution between the version probe and the request, a genuine but
# too-old curl whose `--max-filesize` cannot bound an unknown-length transfer,
# a malformed or unparseable version banner, a hostile `~/.curlrc`, proxy
# environment variables, redirects, oversized responses under a compliant
# curl >= 8.4.0, and HTTP or JSON failures.
#
# It does NOT defend against a curl executable that is itself hostile. Three
# residuals follow directly and are accepted, not solved:
#
#   * A malicious curl can print any version it likes. The banner is a claim
#     by the program under test, so the >= 8.4.0 floor binds a cooperative
#     curl, not an adversarial one.
#   * A malicious curl can accept `--max-filesize` and ignore it, returning a
#     body far larger than the 64 KiB bound.
#   * If the resolved path is a symlink, a same-user process — including the
#     probed program itself — can retarget it between the `--version` probe
#     and the readiness GET, so a different executable can serve the request.
#
# These are local dependency-integrity attacks, and they sit OUTSIDE this
# wrapper's threat model. An attacker who can replace this user's curl can
# equally POST to the broker directly and bypass the wrapper altogether, which
# is the same client-side boundary the readiness race above already documents.
# None of these is a weakness the broker inherits when callers use ordinary
# trusted system dependencies.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
ENV_FILE="${REPO_ROOT}/examples/sidestack-local.env"

if [[ ! -f "${ENV_FILE}" ]]; then
  printf 'claw-sidestack-local: env file not found: %s\n' "${ENV_FILE}" >&2
  printf '  expected the SideStackAI broker profile at examples/sidestack-local.env\n' >&2
  exit 2
fi

# shellcheck source=/dev/null
source "${ENV_FILE}"

EFFECTIVE_BASE_URL="${OPENAI_BASE_URL:-}"

if [[ -z "${EFFECTIVE_BASE_URL}" ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL is empty after sourcing %s\n' "${ENV_FILE}" >&2
  exit 3
fi

if [[ "${EFFECTIVE_BASE_URL}" == *11434* ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL must not point at :11434 (raw Ollama).\n' >&2
  printf '  offending value: %s\n' "${EFFECTIVE_BASE_URL}" >&2
  printf '  expected the SideStackAI broker on :11435.\n' >&2
  exit 3
fi

BROKER_ALLOWLIST_REGEX='^http://(127\.0\.0\.1|localhost):11435(/.*)?$'
if [[ ! "${EFFECTIVE_BASE_URL}" =~ ${BROKER_ALLOWLIST_REGEX} ]]; then
  printf 'claw-sidestack-local: LAW 1 refusal — OPENAI_BASE_URL is not an allowed SideStackAI broker URL.\n' >&2
  printf '  offending value: %s\n' "${EFFECTIVE_BASE_URL}" >&2
  printf '  allowlist regex: %s\n' "${BROKER_ALLOWLIST_REGEX}" >&2
  exit 3
fi

{
  printf 'claw-sidestack-local: active profile\n'
  printf '  OPENAI_BASE_URL=%s\n' "${OPENAI_BASE_URL}"
  printf '  RUSTY_CLAUDE_LLM_CALLER=%s\n' "${RUSTY_CLAUDE_LLM_CALLER:-}"
  printf '  RUSTY_CLAUDE_TASK_TYPE=%s\n' "${RUSTY_CLAUDE_TASK_TYPE:-}"
  alias_names="$(compgen -e | grep -E '^RUSTY_CLAUDE_MODEL_ALIAS__' | sort | tr '\n' ' ' || true)"
  if [[ -n "${alias_names}" ]]; then
    printf '  model alias env names: %s\n' "${alias_names% }"
  else
    printf '  model alias env names: (none)\n'
  fi
} >&2

# --- canonical entrypoint ---------------------------------------------------
#
# LAW 1 has already been evaluated above; nothing below it may relax that.
# From here the only question is whether the canonical executable is the one
# we are allowed to run.

if [[ -z "${CLAW_CANONICAL_PATH:-}" && -z "${HOME:-}" ]]; then
  printf 'claw-sidestack-local: HOME is unset and CLAW_CANONICAL_PATH was not provided.\n' >&2
  exit 7
fi
CANONICAL_CLAW="${CLAW_CANONICAL_PATH:-${HOME}/.local/bin/claw}"
if [[ "${CANONICAL_CLAW}" != /* ]]; then
  printf 'claw-sidestack-local: canonical claw path must be absolute: %s\n' "${CANONICAL_CLAW}" >&2
  exit 7
fi
printf '  canonical claw: %s\n' "${CANONICAL_CLAW}" >&2

CANONICAL_STATUS="${SCRIPT_DIR}/claw-canonical-status"
if [[ ! -x "${CANONICAL_STATUS}" ]]; then
  printf 'claw-sidestack-local: canonical status helper missing or not executable: %s\n' "${CANONICAL_STATUS}" >&2
  exit 7
fi

set +e
status_report="$("${CANONICAL_STATUS}" 2>&1)"
status_rc=$?
set -e

print_status_report() {
  if [[ -n "${status_report}" ]]; then
    while IFS= read -r status_line; do
      printf '  %s\n' "${status_line}" >&2
    done <<<"${status_report}"
  fi
}

case "${status_rc}" in
  0)
    ;;
  10)
    print_status_report
    if [[ "${CLAW_SIDESTACK_ALLOW_STALE:-0}" == "1" ]]; then
      printf 'claw-sidestack-local: WARNING — canonical claw is STALE and CLAW_SIDESTACK_ALLOW_STALE=1 was set.\n' >&2
      printf '  running a build that does not match the locally known origin/main, at your explicit request.\n' >&2
    else
      printf 'claw-sidestack-local: refusing to run a STALE canonical claw.\n' >&2
      printf '  refresh it with: %s/claw-canonical-refresh\n' "${SCRIPT_DIR}" >&2
      printf '  (or set CLAW_SIDESTACK_ALLOW_STALE=1 to override deliberately)\n' >&2
      exit 6
    fi
    ;;
  11)
    print_status_report
    printf 'claw-sidestack-local: canonical claw is missing: %s\n' "${CANONICAL_CLAW}" >&2
    printf '  install it with: %s/claw-canonical-refresh\n' "${SCRIPT_DIR}" >&2
    printf '  this wrapper does NOT fall back to PATH or to ~/.cargo/bin/claw.\n' >&2
    exit 4
    ;;
  12)
    print_status_report
    printf 'claw-sidestack-local: canonical claw has an invalid topology: %s\n' "${CANONICAL_CLAW}" >&2
    printf '  canonical claw must be a regular executable file, never a symlink to a Cargo target.\n' >&2
    exit 5
    ;;
  13)
    print_status_report
    printf 'claw-sidestack-local: WARNING — freshness could not be determined (no locally known origin/main).\n' >&2
    # shellcheck disable=SC2016  # backticks in the user-facing message are literal
    printf '  running the canonical executable anyway; run `git fetch origin main` to restore the check.\n' >&2
    ;;
  *)
    print_status_report
    printf 'claw-sidestack-local: canonical status check failed (exit %s).\n' "${status_rc}" >&2
    exit 7
    ;;
esac


# --- N6 broker readiness preflight ------------------------------------------
#
# Policy: a local coding session must not start when the broker's readiness
# endpoint says starting one would disrupt the Hyperliquid trading lane.
# Stack-Code and Hyperliquid are both tier 3, so equal priority only prevents
# preemption while Hyperliquid is ACTIVELY inferring; an idle resident
# Hyperliquid model can still be evicted. The broker's
# `GET /status/n6_planner_ready` applies a 300-second Hyperliquid quiet window
# and is the authority. `/status` is NOT — it reports the slot, not safety.
#
# This gate is a CLIENT-side refusal, not a broker admission reservation. See
# the "Residual race" note in the header.
#
# Everything here runs BEFORE the final topology revalidation below, so no
# network operation ever happens between that check and `exec`.
#
# The classifier is TAIL-AWARE, not verb-aware. Several verbs (`skills`,
# `plan`, `task`) dispatch locally or to a provider depending on what follows
# them, and two flags (`-p`, `--resume`) force a provider dispatch regardless
# of any positional. Classifying on the leading verb alone is what let
# `claw skills help overview` — a `CliAction::Prompt` — run ungated.
#
# Where the exact upstream model cannot be proven before `exec`, the wrapper
# REFUSES (exit 9) rather than gate on a model the invocation will not use.

# Subcommands proven (by reading the CLI dispatch in
# rust/crates/rusty-claude-cli/src/main.rs) not to issue a provider request:
# each one dispatches to a local printer/reporter and never constructs a
# `LiveCli`.
#
# `skills`, `plan`, and `task` are deliberately NOT in this list. Their
# classification depends on the argument TAIL, not on the leading verb, so
# each one gets a dedicated arm in `n6_classify_invocation` below. Treating
# `skills` as unconditionally local is exactly the defect this list used to
# carry: `claw skills help overview` is a PROMPT, not a local report.
N6_NON_INFERENCE_SUBCOMMANDS=" version status sandbox doctor acp state init config diff export system-prompt dump-manifests bootstrap-plan agents mcp plugins "

# Deliberately strict, fail-closed reader for the two fields this wrapper
# depends on. Duplicate keys, a non-boolean `ready`, a blank `reason_code`, or
# a `requested_model` that does not correspond to what was asked are all
# treated as "readiness could not be established". python3 is already an
# unconditional dependency of scripts/claw-canonical-refresh, so this adds no
# new runtime requirement; jq is not used anywhere in this repo and is not
# introduced here.
N6_PARSER_PY="$(cat <<'PY'
import json, os, sys

def no_duplicate_keys(pairs):
    seen = {}
    for key, value in pairs:
        if key in seen:
            raise ValueError("duplicate key: " + key)
        seen[key] = value
    return seen

try:
    payload = json.loads(sys.stdin.read(), object_pairs_hook=no_duplicate_keys)
except Exception:
    sys.exit(1)
if not isinstance(payload, dict):
    sys.exit(1)

if "ready" not in payload or not isinstance(payload["ready"], bool):
    sys.exit(1)
reason = payload.get("reason_code")
if not isinstance(reason, str) or not reason.strip():
    sys.exit(1)
reason = reason.strip()
if "|" in reason or "\n" in reason or "\r" in reason:
    sys.exit(1)

sent = os.environ["N6_SENT_MODEL"]
echoed = payload.get("requested_model")
if not isinstance(echoed, str) or not echoed.strip():
    sys.exit(1)
if echoed.strip() not in (sent, sent + ":latest"):
    sys.exit(1)

sys.stdout.write(("READY|" if payload["ready"] else "NOTREADY|") + reason)
PY
)"

n6_trim() {
  # ASCII-whitespace trim, matching the CLI's `str::trim` for the ASCII inputs
  # this wrapper accepts.
  printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# A "bare" name is what the CLI and the provider layer both treat as eligible
# for `RUSTY_CLAUDE_MODEL_ALIAS__*` lookup: ASCII alphanumerics and `_`.
n6_is_bare_name() { [[ "$1" =~ ^[A-Za-z0-9_]+$ ]]; }

# Conservative charset for anything we are willing to put on the wire. Real
# broker model strings (`qwen3:14b`, `qwen3.5:27b`, `openai/qwen3:14b`) fit;
# anything else fails closed rather than being percent-encoded by guesswork.
n6_is_wire_safe_model() { [[ "$1" =~ ^[A-Za-z0-9._:/~+-]+$ ]]; }

n6_env_alias_value() {
  local name="$1" upper key value
  # ASCII-only uppercasing is deliberate: it mirrors the CLI's
  # `to_ascii_uppercase`, and callers only reach here with `[A-Za-z0-9_]`.
  # shellcheck disable=SC2018,SC2019
  upper="$(printf '%s' "${name}" | tr 'a-z' 'A-Z')"
  key="RUSTY_CLAUDE_MODEL_ALIAS__${upper}"
  [[ -n ${!key+x} ]] || return 1
  value="$(n6_trim "${!key}")"
  [[ -n "${value}" ]] || return 1
  printf '%s' "${value}"
}

# Mirror of `strip_routing_prefix` in
# rust/crates/api/src/providers/openai_compat.rs — only these prefixes are
# stripped, and only at the first `/`.
n6_strip_routing_prefix() {
  case "$1" in
    openai/*) printf '%s' "${1#openai/}" ;;
    xai/*)    printf '%s' "${1#xai/}" ;;
    grok/*)   printf '%s' "${1#grok/}" ;;
    qwen/*)   printf '%s' "${1#qwen/}" ;;
    kimi/*)   printf '%s' "${1#kimi/}" ;;
    *)        printf '%s' "$1" ;;
  esac
}

# True when a claw config alias redefines this exact model string. Config
# aliases are consulted by the CLI whenever the env-alias lookup misses, and
# they can rename ANY string, so their presence makes the effective upstream
# model undeterminable from here. The five candidate paths mirror
# `ConfigLoader::discover` in rust/crates/runtime/src/config.rs.
n6_config_alias_defined() {
  local model="$1" config_home
  config_home="${CLAW_CONFIG_HOME:-}"
  if [[ -z "${config_home}" ]]; then
    if [[ -n "${HOME:-}" ]]; then
      config_home="${HOME}/.claw"
    else
      config_home=".claw"
    fi
  fi
  N6_MODEL="${model}" N6_CONFIG_HOME="${config_home}" "${N6_PYTHON}" - <<'PY'
import json, os, sys

model = os.environ["N6_MODEL"]
home = os.path.abspath(os.environ["N6_CONFIG_HOME"])
cwd = os.getcwd()
for path in (
    os.path.join(os.path.dirname(home), ".claw.json"),
    os.path.join(home, "settings.json"),
    os.path.join(cwd, ".claw.json"),
    os.path.join(cwd, ".claw", "settings.json"),
    os.path.join(cwd, ".claw", "settings.local.json"),
):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            parsed = json.load(handle)
    except Exception:
        continue
    if isinstance(parsed, dict):
        aliases = parsed.get("aliases")
        if isinstance(aliases, dict) and model in aliases:
            sys.exit(0)
sys.exit(1)
PY
}

# Resolve the EXACT upstream model string the broker will be asked for, or
# fail closed. Only two shapes are admitted, and both are exact mirrors of the
# CLI + provider resolution chain:
#
#   bare name  -> must hit RUSTY_CLAUDE_MODEL_ALIAS__<UPPER>, and the alias
#                 value must itself be non-bare (so no further alias hop and no
#                 built-in cloud-alias substitution can apply);
#   explicit   -> forwarded verbatim, provided no claw config alias redefines
#                 it, then the routing prefix is stripped for the wire.
#
# Everything else — no `--model`, a bare name with no alias, a chained alias, a
# config-aliased string — is UNDETERMINABLE and refuses.
#
# Prints `OK|<upstream model>` and returns 0, or `ERR|<diagnostic>` and
# returns 1. The diagnostic travels on stdout because the caller reads this
# through a command substitution, where a shell variable set here would be
# discarded with the subshell.
n6_resolve_upstream_model() {
  local requested resolved
  requested="$(n6_trim "$1")"
  if [[ -z "${requested}" ]]; then
    printf 'ERR|the --model value is empty'
    return 1
  fi
  if n6_is_bare_name "${requested}"; then
    if ! resolved="$(n6_env_alias_value "${requested}")"; then
      # shellcheck disable=SC2018,SC2019  # ASCII-only, mirrors the CLI
      printf "ERR|'%s' is a bare alias with no RUSTY_CLAUDE_MODEL_ALIAS__%s export" \
        "${requested}" "$(printf '%s' "${requested}" | tr 'a-z' 'A-Z')"
      return 1
    fi
    if n6_is_bare_name "${resolved}"; then
      printf "ERR|alias '%s' resolves to another bare name ('%s'); the effective upstream model is not determinable here" \
        "${requested}" "${resolved}"
      return 1
    fi
    # The env alias is not the last hop. `parse_args_with_terminal` resolves
    # the `--model` value once when it parses the flag, and the `-p` arm then
    # calls `resolve_model_alias_with_config` AGAIN on the already-resolved
    # string before it builds `CliAction::Prompt`. That second pass misses the
    # env table (the resolved value is no longer a bare name) but still
    # consults the CONFIG aliases, which can rename any string. With
    # `RUSTY_CLAUDE_MODEL_ALIAS__FAST=qwen3:14b` and a config alias mapping
    # `qwen3:14b` to `openai/other`, `--model fast -p hello` preflighted as
    # `qwen3:14b` here would have inference load `other`.
    if n6_config_alias_defined "${resolved}"; then
      printf "ERR|alias '%s' resolves to '%s', which a claw config alias redefines again; the effective upstream model is not determinable here" \
        "${requested}" "${resolved}"
      return 1
    fi
  else
    if n6_config_alias_defined "${requested}"; then
      printf "ERR|'%s' is redefined by a claw config alias; the effective upstream model is not determinable here" \
        "${requested}"
      return 1
    fi
    resolved="${requested}"
  fi
  resolved="$(n6_strip_routing_prefix "${resolved}")"
  if [[ -z "${resolved}" ]] || ! n6_is_wire_safe_model "${resolved}"; then
    printf "ERR|resolved upstream model '%s' is empty or contains characters this wrapper will not put on the wire" \
      "${resolved}"
    return 1
  fi
  printf 'OK|%s' "${resolved}"
}

n6_urlencode() {
  local value="$1" out="" index char
  for (( index = 0; index < ${#value}; index++ )); do
    char="${value:index:1}"
    case "${char}" in
      [A-Za-z0-9._~-]) out="${out}${char}" ;;
      *) out="${out}$(printf '%%%02X' "'${char}")" ;;
    esac
  done
  printf '%s' "${out}"
}

# Last `--model` wins, matching the CLI parser, which reassigns on every
# occurrence. Both `--model VALUE` and `--model=VALUE` are supported.
#
# The scan STOPS at the `-p` terminal. `parse_args_with_terminal` returns
# `CliAction::Prompt` the moment it reaches `-p`, carrying whatever `model` had
# been assigned by THEN, and joins every later token into the prompt text. So
# `--model fast -p hello --model deep` dispatches on `fast`, and a scanner that
# ran on to the end of argv would gate on `deep`: readiness approved for one
# model, inference performed on another. Only assignments before the terminal
# are model metadata.
n6_model_flag_value() {
  local found=1 value="" index=0 arg terminal
  local -a argv=( "$@" )
  if terminal="$(n6_prompt_terminal_index "$@")"; then
    if (( terminal > 0 )); then
      argv=( "${argv[@]:0:terminal}" )
    else
      argv=()
    fi
  fi
  while (( index < ${#argv[@]} )); do
    arg="${argv[index]}"
    if [[ "${arg}" == "--model" ]]; then
      if (( index + 1 >= ${#argv[@]} )); then
        # `--model` with no value: the CLI itself errors out, so there is no
        # inference to gate, but there is also no model to resolve.
        return 1
      fi
      value="${argv[index + 1]}"
      found=0
      index=$(( index + 2 ))
      continue
    fi
    # Any OTHER value-taking global flag CONSUMES the token after it, so a
    # `--model` standing in that slot is that flag's VALUE and never reaches
    # the CLI's `--model` arm. `--model fast --base-commit --model deep -p
    # hello` dispatches on `fast`: the second `--model` is the `--base-commit`
    # value. A scan that walked one token at a time would read `deep` and gate
    # readiness on a model the invocation never loads.
    if n6_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    if [[ "${arg}" == --model=* ]]; then
      value="${arg#--model=}"
      found=0
    fi
    index=$(( index + 1 ))
  done
  (( found == 0 )) || return 1
  printf '%s' "${value}"
}

# Global flags that consume the following token, so no argv walk mistakes a
# flag VALUE for a subcommand, a `-p` terminal, or a `--model` option. This is
# the EXACT set of `--flag value` arms in `parse_args_with_terminal`, and it
# must stay exact in BOTH directions:
#
#   under-inclusion  a real value slot is walked as if it were an option, so a
#                    `--model` sitting in one is read as a model flag that the
#                    CLI never saw (readiness gates a model inference will not
#                    use);
#   over-inclusion   a token the CLI treats as an ordinary positional is
#                    skipped ALONG WITH the one after it, so a real `-p`
#                    terminal or a real `--model` can be swallowed. That is not
#                    a safe direction either: `dump-manifests --manifests-dir
#                    -p foo` is `CliAction::Prompt` in the CLI, and swallowing
#                    its `-p` classifies the invocation on the `dump-manifests`
#                    positional instead -- a readiness BYPASS.
#
# `--manifests-dir` is deliberately ABSENT: it is parsed by the
# `dump-manifests` subcommand parser, never by the global loop, so the global
# loop pushes it onto the positional vector like any other token.
n6_flag_takes_value() {
  case "$1" in
    --model|--permission-mode|--output-format|--allowed-tools|--allowedTools|--reasoning-effort|--base-commit) return 0 ;;
    *) return 1 ;;
  esac
}

# Global flags the CLI consumes wherever they appear WITHOUT taking a separate
# token, including every `--flag=value` form. None of these ever contributes to
# the positional `rest` vector the CLI builds.
n6_is_global_inline_flag() {
  case "$1" in
    --dangerously-skip-permissions|--compact|--allow-broad-cwd|--print) return 0 ;;
    --model=*|--permission-mode=*|--output-format=*|--allowedTools=*|--allowed-tools=*|--reasoning-effort=*|--base-commit=*) return 0 ;;
    *) return 1 ;;
  esac
}

# Index of the `-p` that TERMINATES the CLI's argument loop, or nothing.
#
# `parse_args_with_terminal` puts no `rest.is_empty()` guard on its `-p` arm, so
# `-p` is recognized wherever it appears, and that arm RETURNS
# `CliAction::Prompt` immediately: `args[index + 1..]` is joined into the prompt
# text and nothing after it is ever parsed as an option again. Two consequences
# that both the classifier and the model scanner depend on:
#
#   * options BEFORE the terminal are real options and still count;
#   * every token AFTER it is prompt DATA -- not a model flag, not a local verb,
#     not a wrapper override, not a help or version flag.
#
# Value-taking global flags consume their following token first, so a `-p`
# sitting in a flag VALUE slot is a value, never the terminal.
#
# Prints the index and returns 0 when a terminal exists; returns 1 otherwise.
n6_prompt_terminal_index() {
  local -a argv=( "$@" )
  local index=0
  while (( index < ${#argv[@]} )); do
    if n6_flag_takes_value "${argv[index]}"; then
      index=$(( index + 2 ))
      continue
    fi
    if [[ "${argv[index]}" == "-p" ]]; then
      printf '%s' "${index}"
      return 0
    fi
    index=$(( index + 1 ))
  done
  return 1
}

# True when the CLI's post-loop `wants_help` / `wants_version` checks would
# fire. Both return a local printer (`CliAction::Help` / `CliAction::Version`)
# that constructs no `LiveCli` and reaches no provider.
#
# The guards are mirrored exactly, and neither is "a help flag appears in
# argv":
#
#   `--help` / `-h`     set wants_help only while the positional vector is
#                       still EMPTY, or when its first entry is one of the four
#                       subcommands the CLI intercepts (`prompt`, `commit`,
#                       `pr`, `issue`). Anywhere else the flag is PUSHED into
#                       the positional vector and becomes prompt text, which is
#                       why `explain this --help` is a prompt, not a help
#                       request.
#   `--version` / `-V`  set wants_version wherever they appear.
#
# `--resume`, `--resume=...`, `--acp` and `-acp` are tracked because the CLI
# pushes a positional for each of them. That makes the vector non-empty, which
# changes what a LATER `--help` means -- `--resume --help` is a resumed session,
# not help.
#
# Callers MUST rule out a `-p` terminal first: `-p` returns from inside the
# argument loop, before either check is reached.
n6_wants_help_or_version() {
  local -a argv=( "$@" )
  local index=0 arg first_positional="" rest_empty=1
  while (( index < ${#argv[@]} )); do
    arg="${argv[index]}"
    if n6_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    case "${arg}" in
      --version|-V)
        return 0
        ;;
      --help|-h)
        if (( rest_empty == 1 )); then
          return 0
        fi
        case "${first_positional}" in
          prompt|commit|pr|issue) return 0 ;;
        esac
        index=$(( index + 1 ))
        continue
        ;;
      --resume|--resume=*|--acp|-acp)
        if (( rest_empty == 1 )); then
          first_positional="${arg}"
          rest_empty=0
        fi
        index=$(( index + 1 ))
        continue
        ;;
    esac
    if n6_is_global_inline_flag "${arg}"; then
      index=$(( index + 1 ))
      continue
    fi
    if (( rest_empty == 1 )) && [[ "${arg}" == -* ]]; then
      # The CLI ERRORS on an unrecognized option while the positional vector is
      # empty, so dropping it here can never produce a local verdict by itself.
      index=$(( index + 1 ))
      continue
    fi
    if (( rest_empty == 1 )); then
      first_positional="${arg}"
      rest_empty=0
    fi
    index=$(( index + 1 ))
  done
  return 1
}

# Two flags make the CLI dispatch to a model-backed action regardless of what
# follows, so no positional scan can classify them:
#
#   -p        `parse_args_with_terminal` joins the ENTIRE remaining argv into a
#             prompt and returns `CliAction::Prompt`. `-p status` is a PROMPT
#             whose text happens to read "status", not the local status report.
#   --resume  routes to `parse_resume_args`, producing `ResumeSession` or
#             `ResumeRepl`; both continue a real session. `--resume status`
#             resumes a session reference named "status".
#
# Both are unconditionally inference-capable.
n6_forces_inference() {
  local -a argv=( "$@" )
  local index=0 arg
  while (( index < ${#argv[@]} )); do
    arg="${argv[index]}"
    if n6_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    case "${arg}" in
      -p|--resume|--resume=*) return 0 ;;
    esac
    index=$(( index + 1 ))
  done
  return 1
}

# Reconstruct the positional `rest` vector `parse_args_with_terminal` builds,
# emitted NUL-separated so an argument containing a newline cannot split. An
# unrecognized `-…` token is dropped only while `rest` is still empty, matching
# the CLI, which errors on it there and pushes it everywhere else.
n6_cli_rest() {
  local -a argv=( "$@" ) rest=()
  local index=0 arg
  while (( index < ${#argv[@]} )); do
    arg="${argv[index]}"
    if n6_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    if n6_is_global_inline_flag "${arg}"; then
      index=$(( index + 1 ))
      continue
    fi
    if (( ${#rest[@]} == 0 )) && [[ "${arg}" == -* ]]; then
      index=$(( index + 1 ))
      continue
    fi
    rest+=( "${arg}" )
    index=$(( index + 1 ))
  done
  (( ${#rest[@]} )) && printf '%s\0' "${rest[@]}"
  return 0
}

# Exact mirror of `classify_skills_slash_command` in
# rust/crates/commands/src/lib.rs. The CLI joins EVERY token after `skills`
# with a single space (`join_optional_args`), trims it, and keeps the
# invocation local for only these whole-string forms. Anything else becomes
# `SkillSlashDispatch::Invoke`, i.e. `CliAction::Prompt`.
#
# A first-token test is therefore WRONG — the tail decides. `skills help
# overview`, `skills list extra`, `skills <skill>`, and `skills <skill> <args>`
# are all prompts.
#
# Takes the full `rest` vector; the leading `skills` token is dropped here.
n6_skills_is_local() {
  shift || true
  local IFS=' '
  local joined
  joined="$(n6_trim "$*")"
  case "${joined}" in
    ''|list|help|-h|--help|install) return 0 ;;
    'install '*) return 0 ;;
    *) return 1 ;;
  esac
}

# Plan-tail flags that consume the following token, mirroring the value-taking
# arms of `parse_plan_subcommand_args`. Needed so a `--wrapper` occupying
# another flag's VALUE slot is read as that value, not as an override.
n6_plan_flag_takes_value() {
  case "$1" in
    --report-format|--substrate-url|--fast-model|--wrapper|--step-timeout|--workspace-root) return 0 ;;
    *) return 1 ;;
  esac
}

# `--wrapper` for `claw plan run`: prints the EFFECTIVE operator-supplied value
# (empty when the flag was given without one) and returns 0, or returns 1 when
# the flag is absent. Scanned over the plan tail, where the CLI parses it.
#
# LAST assignment wins. `parse_plan_subcommand_args` reassigns `wrapper` on
# every occurrence and never breaks out of its loop, so
# `--wrapper <this-wrapper> --wrapper /usr/bin/claw` runs the plan's
# model-bearing steps through `/usr/bin/claw`. A first-match reader would call
# that plan safely self-wrapped and wave through exactly the case that escapes
# the readiness gate. The converse ordering matters too: with
# `--wrapper /usr/bin/claw --wrapper <this-wrapper>` the runner really does use
# this wrapper, so refusing it would be a false refusal.
#
# `--wrapper` given as the LAST token is an error in the CLI ("missing value
# for --wrapper"); it is recorded here as an empty assignment so the caller
# fails closed rather than falling back to an earlier value.
n6_plan_wrapper_override() {
  local -a rest=( "$@" )
  local index=0 arg found=1 value=""
  while (( index < ${#rest[@]} )); do
    arg="${rest[index]}"
    if [[ "${arg}" == "--wrapper" ]]; then
      value=""
      if (( index + 1 < ${#rest[@]} )); then
        value="${rest[index + 1]}"
      fi
      found=0
      index=$(( index + 2 ))
      continue
    fi
    if [[ "${arg}" == --wrapper=* ]]; then
      value="${arg#--wrapper=}"
      found=0
      index=$(( index + 1 ))
      continue
    fi
    if n6_plan_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    index=$(( index + 1 ))
  done
  (( found == 0 )) || return 1
  printf '%s' "${value}"
}

# `--workspace-root` for `claw plan run`: prints the EFFECTIVE value and
# returns 0, or returns 1 when the flag is absent. LAST assignment wins, for
# the same reason as `--wrapper` -- `parse_plan_subcommand_args` reassigns
# `workspace_root` on every occurrence and never breaks out of its loop.
#
# This value is load-bearing for the DEFAULT-wrapper proof: the step executor
# applies it as `Command::current_dir`, and a relative program path is resolved
# by the child AFTER that chdir. So the executable a defaulted `plan run`
# actually spawns is `<workspace-root>/scripts/claw-sidestack-local`, not
# `<cwd>/scripts/claw-sidestack-local`.
n6_plan_workspace_root_override() {
  local -a rest=( "$@" )
  local index=0 arg found=1 value=""
  while (( index < ${#rest[@]} )); do
    arg="${rest[index]}"
    if [[ "${arg}" == "--workspace-root" ]]; then
      value=""
      if (( index + 1 < ${#rest[@]} )); then
        value="${rest[index + 1]}"
      fi
      found=0
      index=$(( index + 2 ))
      continue
    fi
    if [[ "${arg}" == --workspace-root=* ]]; then
      value="${arg#--workspace-root=}"
      found=0
      index=$(( index + 1 ))
      continue
    fi
    if n6_plan_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    index=$(( index + 1 ))
  done
  (( found == 0 )) || return 1
  printf '%s' "${value}"
}

# Presence of a BOOLEAN plan-tail flag, mirroring the boolean arms of
# `parse_plan_subcommand_args`.
#
# VALUE-SLOT AWARE, and that is the whole point. The parser consumes the token
# after every value-taking flag, so in `--fast-model --dry-run` the `--dry-run`
# is fast_model's VALUE and `dry_run` stays FALSE. A naive "argv contains
# --dry-run" test would read that as a dry run and hand a spawn-capable
# invocation a bypass -- exactly the mistake this helper exists to prevent.
#
# Over-reporting a flag the CLI would not set is the SAFE direction only for
# spawn-capable modes; for the non-spawning `--dry-run` classification the
# mirror must be exact, so the value-slot skip is mandatory here.
n6_plan_has_flag() {
  local wanted="$1"
  shift
  local -a rest=( "$@" )
  local index=0 arg
  while (( index < ${#rest[@]} )); do
    arg="${rest[index]}"
    if [[ "${arg}" == "${wanted}" ]]; then
      return 0
    fi
    if n6_plan_flag_takes_value "${arg}"; then
      index=$(( index + 2 ))
      continue
    fi
    index=$(( index + 1 ))
  done
  return 1
}

# Absolute form of a path with its directory resolved, without requiring
# `realpath` (absent by default on macOS).
n6_resolve_path() {
  local path="$1" dir base
  [[ -n "${path}" ]] || return 1
  dir="$(dirname -- "${path}")"
  base="$(basename -- "${path}")"
  ( cd -- "${dir}" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "${base}" ) || return 1
}

# Three-way classification of THIS invocation:
#
#   local            proven to dispatch to a local printer/reporter; the
#                    readiness gate is bypassed
#   inference        can reach a provider; the readiness gate must run
#   refuse|<reason>  can reach a provider, but the EXACT upstream model is not
#                    determinable here — fail closed before canonical `exec`
#
# Anything unrecognized falls through to `inference`, never to `local`.
n6_classify_invocation() {
  local -a rest=()
  local token subcommand wrapper_override resolved_wrapper self_wrapper
  local plan_cwd_wrapper plan_spawn_wrapper plan_workspace_root plan_wrapper_base

  # Mirror the CLI's own precedence, which is NOT the order the tokens appear
  # in argv:
  #
  #   1. `-p` returns `CliAction::Prompt` from INSIDE the argument loop, so it
  #      short-circuits the post-loop `wants_help` / `wants_version` checks
  #      entirely. In `--help --model fast -p status` the leading `--help`
  #      never gets to decide anything: the invocation is a prompt, and gating
  #      it on that flag is a readiness BYPASS, not a help request.
  #   2. `wants_help` / `wants_version` are evaluated after the loop and before
  #      any positional dispatch, including before the `--resume` branch.
  #   3. `--resume` forces a session dispatch only when nothing above fired.
  #
  # Testing the FIRST token for a help flag, as this classifier used to, gets
  # step 1 backwards.
  if n6_prompt_terminal_index "$@" >/dev/null; then
    printf 'inference'
    return 0
  fi

  if n6_wants_help_or_version "$@"; then
    printf 'local'
    return 0
  fi

  if n6_forces_inference "$@"; then
    printf 'inference'
    return 0
  fi

  while IFS= read -r -d '' token; do
    rest+=( "${token}" )
  done < <(n6_cli_rest "$@")

  subcommand="${rest[0]-}"
  case "${subcommand}" in
    '')
      # No positional at all: the interactive REPL, or a piped one-shot prompt.
      printf 'inference'
      return 0
      ;;
    help)
      # `claw help` alone is `CliAction::Help`, a local printer, but the verb
      # is NOT unconditionally local: `parse_local_help_action` has no `help`
      # topic and `parse_single_word_command_alias` declines the two-token
      # help-flag form, so `help --help` and `help -h` fall through to the
      # prompt catch-all. Every other `help ...` shape is a CLI usage error,
      # which is gated here rather than bypassed.
      if (( ${#rest[@]} == 1 )); then
        printf 'local'
      else
        printf 'inference'
      fi
      return 0
      ;;
    skills)
      if n6_skills_is_local "${rest[@]}"; then
        printf 'local'
      else
        printf 'inference'
      fi
      return 0
      ;;
    task)
      if [[ "${rest[1]-}" == "run" ]]; then
        # shellcheck disable=SC2016  # backticks in the user-facing message are literal
        printf 'refuse|`claw task run` takes its model from the task spec (its `model` field, or the bridge default `fast-default`), never from the CLI --model flag, and the effective upstream model is whatever the broker resolves that request to — a value first observable in the broker response, after inference has already happened. The exact upstream model cannot be proven before execution, so this wrapper refuses rather than gate on a model the task will not use.'
        return 0
      fi
      # Every other `claw task …` form is a CLI usage error, but it is not
      # proven local, so it is gated rather than bypassed.
      printf 'inference'
      return 0
      ;;
    plan)
      # `plan run` itself issues no provider request (its only network op is a
      # read-only `GET /models` substrate probe). Every model-bearing step is
      # spawned back through THIS wrapper as `--model fast … prompt …`, where
      # it is gated on its own — but ONLY while the runner uses its default
      # wrapper. An operator-supplied `--wrapper` breaks that proof.
      if [[ "${rest[1]-}" == "run" ]]; then
        # -- Effective mode: DRY RUN. `--dry-run` reaches a NON-SPAWNING
        #    outcome under BOTH branches of `run_plan_subcommand`, so no child
        #    wrapper can run and its identity is irrelevant here:
        #
        #      with --workspace-write-preview  the preview branch is entered
        #        first and returns EXIT_PARSE_ERROR before resolving a wrapper
        #        or a workspace root. The parser rejects the pair outright too
        #        ("--workspace-write-preview cannot be combined with
        #        --dry-run"). ORDER CANNOT CHANGE THIS: both flags are
        #        order-independent booleans tested AFTER the parse loop, so
        #        `--dry-run --workspace-write-preview` and
        #        `--workspace-write-preview --dry-run` are the same refusal.
        #      without it  the dry-run arm builds its report from
        #        `validate_plan` + `preflight::precheck` ONLY. It never binds a
        #        wrapper path at all (`let wrapper_path = ...` lives in the
        #        live `else` arm), never probes the substrate, and never spawns
        #        a subprocess.
        #
        #    `--workspace-root` is likewise a parse error without
        #    `--workspace-write-preview`, so it cannot move a spawn here either.
        #
        #    Canonical `claw` still execs locally to PERFORM the dry run. That
        #    is the local validator, not a model-bearing child, and it is the
        #    same local dispatch every other non-inference verb gets.
        if n6_plan_has_flag --dry-run "${rest[@]}"; then
          printf 'local'
          return 0
        fi
        self_wrapper="$(n6_resolve_path "${BASH_SOURCE[0]}" || true)"
        if wrapper_override="$(n6_plan_wrapper_override "${rest[@]}")"; then
          # An explicit `--wrapper` is stored VERBATIM as `ClawCommand.program`
          # and spawned as `Command::new(program).current_dir(<workspace-root>)`
          # (`runner.rs:130-162`, `runner.rs:433-435`). The chdir happens BEFORE
          # the exec, so which executable really runs depends on the PATH CLASS
          # of the operator's value -- checking it against the CALLER's CWD
          # proves the wrong file for two of the three classes:
          #
          #   absolute            base-independent. The child's chdir cannot
          #                       move it, which is why an absolute path to
          #                       this wrapper is the documented escape hatch
          #                       for previewing into another tree.
          #   relative with slash resolved by execvp AFTER the chdir, so the
          #                       real program is `<execution-base>/<value>`.
          #                       An identically named path under the caller's
          #                       CWD proves NOTHING about it.
          #   bare name, no slash execvp searches PATH and never the CWD. This
          #                       wrapper has no PATH fallback and cannot prove
          #                       which entry the child would pick, so it fails
          #                       CLOSED.
          #
          # The execution base for a relative value is mode-specific:
          #   preview  `--workspace-root` (else the CWD) -- the preview branch
          #            passes it straight through as the step executor CWD.
          #   normal   the CWD only. `--workspace-root` without
          #            `--workspace-write-preview` is rejected by
          #            `parse_plan_subcommand_args` (`main.rs:4661-4668`), so a
          #            normal run cannot be relocated.
          if [[ "${wrapper_override}" == /* ]]; then
            resolved_wrapper="$(n6_resolve_path "${wrapper_override}" || true)"
          elif [[ "${wrapper_override}" == */* ]]; then
            plan_wrapper_base="."
            if n6_plan_has_flag --workspace-write-preview "${rest[@]}"; then
              if ! plan_workspace_root="$(n6_plan_workspace_root_override "${rest[@]}")" \
                 || [[ -z "${plan_workspace_root}" ]]; then
                plan_workspace_root="."
              fi
              plan_wrapper_base="${plan_workspace_root}"
            fi
            resolved_wrapper="$(n6_resolve_path \
              "${plan_wrapper_base%/}/${wrapper_override}" || true)"
          else
            # PATH-searched: unprovable by construction. Left empty so the
            # shared refusal below fires.
            resolved_wrapper=""
          fi
          if [[ -z "${self_wrapper}" || -z "${resolved_wrapper}" \
                || "${resolved_wrapper}" != "${self_wrapper}" ]]; then
            # shellcheck disable=SC2016  # backticks in the user-facing message are literal
            printf 'refuse|`claw plan run --wrapper %s` would spawn every model-bearing step through an executable other than this wrapper, so those steps are not proven to pass the readiness gate. Omit --wrapper only when the runner default resolves back to this wrapper, or point --wrapper at this wrapper.' \
              "${wrapper_override}"
            return 0
          fi
        else
          # NO override. That is not the same as "safe": the runner default is
          # the RELATIVE path `scripts/claw-sidestack-local`, and nothing binds
          # it to the tree this wrapper lives in. The step executor sets
          # `Command::current_dir(<workspace-root>)` and the child resolves the
          # relative program AFTER that chdir, so the executable that really
          # runs is `<workspace-root>/scripts/claw-sidestack-local`.
          #
          # WHICH bases must be proven depends on the EXECUTION MODE, because
          # the two spawn-capable branches do not share a precheck:
          #
          #   normal   the live arm runs `wrapper_path.exists()` in the plan
          #            process (resolved against its CWD) BEFORE any spawn and
          #            reports substrate-unavailable when it fails, so an
          #            absent CWD default really does mean nothing spawns.
          #            `--workspace-root` is a parse error without
          #            `--workspace-write-preview`, so the CWD is the only base
          #            that can carry a spawn.
          #   preview  the `--workspace-write-preview` branch has NO
          #            wrapper-existence precheck AT ALL, and
          #            `run_plan_with_write_preview` still spawns every
          #            read-only step preceding the lone workspace-write step
          #            through `<workspace-root>/scripts/claw-sidestack-local`.
          #            An absent CWD default proves NOTHING about that spawn,
          #            so the effective workspace-root wrapper is validated on
          #            its own and an unresolvable one fails CLOSED. The
          #            escape hatch for a foreign workspace root is an explicit
          #            `--wrapper` pointing at this wrapper: an ABSOLUTE
          #            program path ignores the child's chdir.
          if ! plan_workspace_root="$(n6_plan_workspace_root_override "${rest[@]}")" \
             || [[ -z "${plan_workspace_root}" ]]; then
            plan_workspace_root="."
          fi
          plan_spawn_wrapper="$(n6_resolve_path "${plan_workspace_root%/}/scripts/claw-sidestack-local" || true)"
          if n6_plan_has_flag --workspace-write-preview "${rest[@]}"; then
            if [[ -z "${self_wrapper}" || -z "${plan_spawn_wrapper}" \
                  || "${plan_spawn_wrapper}" != "${self_wrapper}" ]]; then
              # shellcheck disable=SC2016  # backticks in the user-facing message are literal
              printf 'refuse|`claw plan run --workspace-write-preview` spawns the read-only steps before its workspace-write step through `<workspace-root>/scripts/claw-sidestack-local`, which resolves to %s, not to this wrapper (%s), and this branch has no wrapper-existence precheck to stop it. Those steps are not proven to pass the readiness gate. Point --workspace-root at the tree this wrapper lives in, or pass --wrapper pointing at this wrapper.' \
                "${plan_spawn_wrapper:-<unresolvable>}" "${self_wrapper:-<unresolvable>}"
              return 0
            fi
          else
            plan_cwd_wrapper="$(n6_resolve_path "scripts/claw-sidestack-local" || true)"
            if [[ -n "${plan_cwd_wrapper}" && -e "${plan_cwd_wrapper}" ]]; then
              if [[ -z "${self_wrapper}" || -z "${plan_spawn_wrapper}" \
                    || "${plan_cwd_wrapper}" != "${self_wrapper}" \
                    || "${plan_spawn_wrapper}" != "${self_wrapper}" ]]; then
                # shellcheck disable=SC2016  # backticks in the user-facing message are literal
                printf 'refuse|`claw plan run` without --wrapper spawns its model-bearing steps through the runner default `scripts/claw-sidestack-local`, which resolves to %s, not to this wrapper (%s). Those steps are not proven to pass the readiness gate. Run the plan from the tree this wrapper lives in, or pass --wrapper pointing at this wrapper.' \
                  "${plan_spawn_wrapper:-${plan_cwd_wrapper}}" "${self_wrapper:-<unresolvable>}"
                return 0
              fi
            fi
          fi
        fi
      fi
      printf 'local'
      return 0
      ;;
  esac

  if [[ "${N6_NON_INFERENCE_SUBCOMMANDS}" == *" ${subcommand} "* ]]; then
    printf 'local'
    return 0
  fi
  printf 'inference'
}

# Derive the readiness origin from the ALREADY LAW-1-VALIDATED broker URL.
# No second host is hard-coded, and nothing outside the allowlisted origin can
# be reached.
n6_readiness_origin() {
  if [[ "${EFFECTIVE_BASE_URL}" =~ ^(http://(127\.0\.0\.1|localhost):11435)(/.*)?$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

# --- curl capability floor ---------------------------------------------------
#
# The readiness body is bounded with `--max-filesize 65536`, but that option's
# guarantee is VERSION-DEPENDENT. curl documents that before 8.4.0
# `--max-filesize` does not abort a transfer whose size was not known before
# the download began — precisely the chunked / unknown-length shape that an
# unbounded response would arrive in. From 8.4.0 the transfer is aborted once
# the threshold is reached mid-transfer.
#
# Older curl still ACCEPTS `--max-filesize`, so probing for the option, or for
# curl's willingness to parse it, distinguishes nothing. The reported version
# is the only signal available — and, per the trust boundary above, it is a
# signal only because a trusted curl is assumed to report itself honestly.
#
# Therefore: no adequate reported version, no request. Such a curl refuses
# with exit 9 BEFORE the readiness GET, so it never puts a byte on the wire.
# The contract on an old curl is "refuse before transfer", not "transfer with
# an unreliable bound" — the response-size guarantee is never silently
# weakened for any curl that reports itself accurately.
#
# This floor applies ONLY to the inference path, which is the only path that
# performs the readiness GET. Locally dispatched invocations never reach here
# and gain no curl requirement.
N6_CURL_MIN_VERSION="8.4.0"

N6_CURL_VERSION_PY="$(cat <<'PY'
import os, re, sys

# A real banner's first line is `curl <version> (<triple>) libcurl/<version> …`.
# Only a complete, undecorated MAJOR.MINOR.PATCH triple is accepted. A partial
# (`8.4`) or decorated (`8.6.0-DEV`) version is not something this wrapper can
# order unambiguously against the floor, so it is treated as unknown and fails
# closed rather than being guessed at.
line = os.environ.get("N6_CURL_VERSION_LINE", "")
match = re.match(r"^curl ([0-9]{1,5})\.([0-9]{1,5})\.([0-9]{1,5})(?:[ \t]|$)", line)
if not match:
    sys.exit(1)
# Integer tuple comparison, never a string compare: lexicographically "8.10.0"
# sorts BELOW "8.4.0", which would reject a version that satisfies the floor.
found = tuple(int(part) for part in match.groups())
sys.stdout.write("%d.%d.%d" % found)
if found < (8, 4, 0):
    sys.exit(2)
PY
)"

# Bounded, printable-only rendering of anything derived from curl's output, so
# a malformed banner cannot flood the operator's terminal or smuggle control
# sequences into it.
n6_sanitize_version_display() {
  printf '%s' "$1" | LC_ALL=C tr -cd '[:print:]' | cut -c1-60
}

# Checks that the curl at the resolved command path N6_CURL reports a version
# satisfying the floor. The curl command path is resolved once, to an absolute
# path, and reused for both this capability probe and the readiness request
# below; the wrapper never walks PATH a second time looking for another curl,
# so a later PATH change cannot substitute a different command.
#
# This binds the PATH SELECTION, not the executable identity. It does not pin
# a binary, an inode, or a symlink target, and it cannot: a same-user process
# may replace or retarget that path between this probe and the GET, and a
# hostile curl may simply misreport its version here and then ignore
# `--max-filesize` on the request. Those residuals are accepted and are
# described under "Trusted local dependencies" at the top of this file.
#
# Sets n6_curl_version to a bounded, sanitized display string. Returns:
#   0 proven >= 8.4.0   1 unparseable/unknown banner   2 proven older
#   3 the `--version` command itself failed
n6_curl_capability_proven() {
  local raw rc=0 line parsed prc=0
  n6_curl_version="(unknown)"
  # The banner of any real curl is a few hundred bytes. Only its first line,
  # truncated, is ever retained, parsed, or displayed.
  raw="$("${N6_CURL}" --version 2>/dev/null)" || rc=$?
  if (( rc != 0 )); then
    return 3
  fi
  line="${raw%%$'\n'*}"
  line="${line:0:200}"
  parsed="$(N6_CURL_VERSION_LINE="${line}" "${N6_PYTHON}" -c "${N6_CURL_VERSION_PY}" 2>/dev/null)" || prc=$?
  if [[ -n "${parsed}" ]]; then
    n6_curl_version="$(n6_sanitize_version_display "${parsed}")"
  else
    n6_curl_version="$(n6_sanitize_version_display "${line}")"
    [[ -n "${n6_curl_version}" ]] || n6_curl_version="(empty)"
  fi
  case "${prc}" in
    0) return 0 ;;
    2) return 2 ;;
    *) return 1 ;;
  esac
}

# Bounded, single-shot GET. No POST, no retries, no waiting loop, no
# credentials: the readiness endpoint is unauthenticated and the API key must
# never appear in these arguments. `--disable` ignores ~/.curlrc and
# `--noproxy '*'` stops a proxy env var from redirecting the request off-host,
# so the URL built above is the only endpoint that can be contacted.
#
# Sets n6_reason on success. Returns:
#   0 ready=true   1 ready=false   2 transport/timeout   3 non-2xx
#   4 malformed or contract-violating response
n6_readiness_query() {
  local model="$1" origin="$2"
  local url raw http_code body parsed
  url="${origin}/status/n6_planner_ready?requested_model=$(n6_urlencode "${model}")"
  # `--max-filesize` bounds the body this wrapper is willing to buffer. A real
  # readiness answer is a few hundred bytes; anything approaching 64 KiB is not
  # this endpoint answering, so curl aborts (exit 63) and the gate fails closed
  # rather than reading an unbounded body into a shell variable.
  if ! raw="$("${N6_CURL}" --disable --silent --noproxy '*' --get \
      --connect-timeout 2 --max-time 5 --max-filesize 65536 \
      --write-out '\n%{http_code}' "${url}" 2>/dev/null)"; then
    return 2
  fi
  http_code="${raw##*$'\n'}"
  body="${raw%$'\n'*}"
  case "${http_code}" in
    2??) ;;
    *) n6_reason="http ${http_code}"; return 3 ;;
  esac
  if ! parsed="$(printf '%s' "${body}" | N6_SENT_MODEL="${model}" \
      "${N6_PYTHON}" -c "${N6_PARSER_PY}" 2>/dev/null)"; then
    return 4
  fi
  n6_reason="${parsed#*|}"
  case "${parsed%%|*}" in
    READY) return 0 ;;
    NOTREADY) return 1 ;;
    *) return 4 ;;
  esac
}

n6_reason=""
N6_CURL="$(command -v curl || true)"
N6_PYTHON="$(command -v python3 || true)"

n6_class="$(n6_classify_invocation "$@")"

if [[ "${n6_class%%|*}" == "refuse" ]]; then
  printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
  printf '  %s\n' "${n6_class#*|}" >&2
  exit 9
fi

if [[ "${n6_class}" == "inference" ]]; then
  if ! n6_broker_origin="$(n6_readiness_origin)"; then
    printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
    printf '  could not derive a broker origin from the validated OPENAI_BASE_URL: %s\n' "${EFFECTIVE_BASE_URL}" >&2
    exit 9
  fi
  if [[ -z "${N6_CURL}" ]]; then
    printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
    printf '  curl was not found on PATH; the broker readiness endpoint cannot be queried.\n' >&2
    exit 9
  fi
  if [[ -z "${N6_PYTHON}" ]]; then
    printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
    printf '  python3 was not found on PATH; the readiness response cannot be parsed safely.\n' >&2
    exit 9
  fi
  if ! n6_model_raw="$(n6_model_flag_value "$@")"; then
    printf 'claw-sidestack-local: local coding readiness requires an explicit --model for this invocation.\n' >&2
    printf '  Example: --model fast\n' >&2
    printf '  Without it the effective upstream model is unknown, so the broker cannot be asked\n' >&2
    printf '  whether starting this session is safe for the Hyperliquid lane.\n' >&2
    exit 9
  fi
  if n6_resolution="$(n6_resolve_upstream_model "${n6_model_raw}")"; then
    n6_requested_model="${n6_resolution#OK|}"
  else
    printf 'claw-sidestack-local: local coding readiness could not resolve the requested model.\n' >&2
    printf '  %s\n' "${n6_resolution#ERR|}" >&2
    printf '  Pass an explicit upstream model (for example --model fast, or --model qwen3:14b).\n' >&2
    exit 9
  fi
  # Capability check for the resolved curl, AFTER the exact upstream model is
  # known and BEFORE any byte reaches the network. A curl that does not report
  # an adequate version refuses here, so the readiness GET is never issued and
  # canonical never execs.
  n6_curl_rc=0
  n6_curl_capability_proven || n6_curl_rc=$?
  if (( n6_curl_rc != 0 )); then
    printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
    printf '  curl %s or newer is required for bounded readiness responses\n' "${N6_CURL_MIN_VERSION}" >&2
    case "${n6_curl_rc}" in
      2) printf '  detected curl version: %s\n' "${n6_curl_version}" >&2 ;;
      3) printf '  detected curl version: (the curl --version command failed)\n' >&2 ;;
      *) printf '  detected curl version: (unrecognized banner: %s)\n' "${n6_curl_version}" >&2 ;;
    esac
    printf '  curl executable: %s\n' "${N6_CURL}" >&2
    printf '  older curl does not enforce --max-filesize once a transfer of unknown\n' >&2
    printf '  length is already in progress, so the 64 KiB bound on the readiness body\n' >&2
    printf '  cannot be guaranteed. Refusing before the request rather than reading an\n' >&2
    printf '  unbounded response.\n' >&2
    exit 9
  fi
  n6_rc=0
  n6_readiness_query "${n6_requested_model}" "${n6_broker_origin}" || n6_rc=$?
  case "${n6_rc}" in
    0)
      printf '  broker readiness: ready (%s) for %s\n' "${n6_reason}" "${n6_requested_model}" >&2
      ;;
    1)
      printf 'claw-sidestack-local: local coding readiness refused\n' >&2
      printf 'requested model: %s\n' "${n6_requested_model}" >&2
      printf 'reason_code: %s\n' "${n6_reason}" >&2
      printf '  the broker declined this session; it is not queued and no model was loaded.\n' >&2
      printf '  re-run once the broker reports ready — this wrapper refuses, it never waits.\n' >&2
      exit 8
      ;;
    2)
      printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
      printf 'requested model: %s\n' "${n6_requested_model}" >&2
      printf '  the broker readiness endpoint was unreachable or timed out.\n' >&2
      exit 9
      ;;
    3)
      printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
      printf 'requested model: %s\n' "${n6_requested_model}" >&2
      printf '  the broker readiness endpoint returned %s.\n' "${n6_reason}" >&2
      exit 9
      ;;
    *)
      printf 'claw-sidestack-local: local coding readiness could not be established\n' >&2
      printf 'requested model: %s\n' "${n6_requested_model}" >&2
      printf '  the broker readiness response was malformed or did not answer for this model.\n' >&2
      exit 9
      ;;
  esac
fi

# --- final topology revalidation, immediately before exec -------------------
#
# Nothing may run between this block and `exec`. See the Residual race note in
# the header: this narrows the same-user window, it does not close it.
if [[ -L "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is a symlink: %s\n' "${CANONICAL_CLAW}" >&2
  printf '  canonical claw must be a regular executable file, never a symlink to a Cargo target.\n' >&2
  exit 5
fi
if [[ ! -e "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is missing: %s\n' "${CANONICAL_CLAW}" >&2
  printf '  this wrapper does NOT fall back to PATH or to ~/.cargo/bin/claw.\n' >&2
  exit 4
fi
if [[ ! -f "${CANONICAL_CLAW}" || ! -x "${CANONICAL_CLAW}" ]]; then
  printf 'claw-sidestack-local: canonical claw is not a regular executable file: %s\n' "${CANONICAL_CLAW}" >&2
  exit 5
fi

exec "${CANONICAL_CLAW}" "$@"
